        (should-not (eq (current-buffer) first))
        (should (eq (window-parameter (selected-window) 'window-side) 'top))
        (should (= (length (window-list)) 2))))))

(ert-deftest jg-ghostel-project-and-global-switches-respect-session-modes ()
  (jg-ghostel-test--session
    (setq jg-ghostel-test--project "/tmp/alpha/")
    (jg-ghostel-project)
    (let ((project-terminal (current-buffer)))
      (jg-ghostel-toggle-size)
      (jg-ghostel-global-new)
      (let ((global-terminal (current-buffer)))
