(ert-deftest jg-ghostel-prefix-toggle-creates-and-remembers-last-used ()
  (jg-ghostel-test--session
    (jg-ghostel-toggle)
    (let ((first (current-buffer)))
      (jg-ghostel-toggle '(4))
      (let ((second (current-buffer)))
        (should-not (eq first second))
        (should (= (alist-get 'instance ghostel-identity) 2))
        (jg-ghostel-toggle)
        (jg-ghostel-toggle)
        (should (eq (current-buffer) second))
        (jg-ghostel-previous)
        (should (eq (current-buffer) first))
        (jg-ghostel-toggle)
        (jg-ghostel-toggle)
        (should (eq (current-buffer) first))))))

(ert-deftest jg-ghostel-cycling-wraps-within-context-in-slot-order ()
  (jg-ghostel-test--session
    (jg-ghostel-global-new)
    (let ((global (current-buffer)))
      (setq jg-ghostel-test--project "/tmp/alpha/")
      (jg-ghostel-project)
      (let ((first (current-buffer)))
        (jg-ghostel-new)
        (let ((second (current-buffer)))
          (jg-ghostel-new)
          (let ((third (current-buffer)))
            (jg-ghostel-next)
            (should (eq (current-buffer) first))
            (jg-ghostel-next)
            (should (eq (current-buffer) second))
            (jg-ghostel-previous)
            (should (eq (current-buffer) first))
            (jg-ghostel-previous)
            (should (eq (current-buffer) third))
            (should-not (eq (current-buffer) global))))))))

(ert-deftest jg-ghostel-switch-is-scoped-and-all-switch-can-cross-contexts ()
  (jg-ghostel-test--session
    (jg-ghostel-global-new)
    (let ((global (current-buffer)))
      (setq jg-ghostel-test--project "/tmp/alpha/")
      (jg-ghostel-project)
      (let ((first (current-buffer)))
        (jg-ghostel-new)
        (let ((second (current-buffer)))
          (cl-letf (((symbol-function 'completing-read)
                     (lambda (_prompt names &rest _args)
                       (should (member (buffer-name first) names))
                       (should (member (buffer-name second) names))
                       (should-not (member (buffer-name global) names))
                       (buffer-name first))))
            (jg-ghostel-switch))
          (should (eq (current-buffer) first))
          (cl-letf (((symbol-function 'completing-read)
                     (lambda (_prompt names &rest _args)
                       (should (member (buffer-name global) names))
                       (buffer-name global))))
            (jg-ghostel-switch-all))
          (should (eq (current-buffer) global))
          (jg-ghostel-new)
          (should (equal (alist-get 'name ghostel-identity)
                         "*ghostel: global*")))))))

(ert-deftest jg-ghostel-empty-selection-and-cycle-do-not-create-terminals ()
  (jg-ghostel-test--session
    (should-error (jg-ghostel-switch) :type 'user-error)
    (should-error (jg-ghostel-switch-all) :type 'user-error)
    (should-error (jg-ghostel-next) :type 'user-error)
    (should-error (jg-ghostel-previous) :type 'user-error)
    (should (= (length (window-list)) 1))))

(ert-deftest jg-ghostel-visible-switches-preserve-each-terminals-mode ()
  (jg-ghostel-test--session
    (setq jg-ghostel-test--project "/tmp/alpha/")
    (jg-ghostel-toggle)
    (let ((full-terminal (current-buffer)))
      (jg-ghostel-toggle-size)
      (jg-ghostel-new)
      (let ((quake-terminal (current-buffer)))
        (should (eq (window-parameter (selected-window) 'window-side) 'top))
        (dotimes (_ 3)
          (jg-ghostel-previous)
          (should (eq (current-buffer) full-terminal))
          (should (= (length (window-list)) 1))
          (jg-ghostel-next)
          (should (eq (current-buffer) quake-terminal))
          (should (eq (window-parameter (selected-window) 'window-side) 'top)))
        (jg-ghostel-toggle)
        (jg-ghostel-toggle)
        (should (eq (current-buffer) quake-terminal))
        (should (eq (window-parameter (selected-window) 'window-side) 'top))
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (&rest _args) (buffer-name full-terminal))))
          (jg-ghostel-switch))
        (should (= (length (window-list)) 1))
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (&rest _args) (buffer-name quake-terminal))))
          (jg-ghostel-switch-all))
        (should (eq (window-parameter (selected-window) 'window-side) 'top))))))

(ert-deftest jg-ghostel-new-fullscreen-uses-current-context-and-remembers-mode ()
  (dolist (root '(nil "/tmp/alpha/"))
    (jg-ghostel-test--session
      (setq jg-ghostel-test--project root)
      (should (eq (key-binding (kbd "C-c t N")) #'jg-ghostel-new-fullscreen))
      (jg-ghostel-new-fullscreen)
      (let ((terminal (current-buffer)))
        (should (= (length (window-list)) 1))
        (should-not (window-parameter (selected-window) 'window-side))
        (should (equal default-directory (or root (expand-file-name "~/"))))
        (if root
            (should (equal (alist-get 'project-root ghostel-identity) root))
          (should (equal (alist-get 'name ghostel-identity) "*ghostel: global*")))
        (jg-ghostel-toggle)
        (jg-ghostel-toggle)
        (should (eq (current-buffer) terminal))
        (should (= (length (window-list)) 1))))))

(ert-deftest jg-ghostel-quake-creation-commands-ignore-current-view-mode ()
  (dolist (command (list #'jg-ghostel-new #'jg-ghostel-global-new
                         (lambda () (jg-ghostel-toggle '(4)))
                         (lambda () (jg-ghostel-global '(4)))
                         (lambda () (jg-ghostel-project '(4)))))
    (jg-ghostel-test--session
      (setq jg-ghostel-test--project "/tmp/alpha/")
      (jg-ghostel-project)
      (let ((first (current-buffer)))
